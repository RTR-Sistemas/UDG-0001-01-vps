name: Deploy para VPS

# -----------------------------------------------------------------------------
# UndoinG - publicacao automatica no VPS
#
# Aceita DOIS jeitos de autenticar, e escolhe sozinho:
#
#   A) CHAVE SSH  (preferido - e o que o ACESSO_VPS_UNDOING.md descreve)
#        SSH_PRIVATE_KEY   conteudo do arquivo udg_deploy, com BEGIN/END
#        SSH_HOST          udgservidor.online
#        SSH_USER          deploy
#        SSH_KNOWN_HOSTS   saida de: ssh-keyscan udgservidor.online
#
#   B) SENHA  (mais simples, para publicar hoje)
#        VPS_HOST          IP ou dominio do servidor
#        VPS_USER          root (ou o usuario de deploy)
#        VPS_PASSWORD      a senha NOVA
#
# Se SSH_PRIVATE_KEY existir, usa a chave e ignora a senha. Assim voce comeca
# pela senha e migra para chave depois, sem mexer neste arquivo de novo.
#
# O VPS NAO PRECISA DE NENHUMA CONFIGURACAO MANUAL
#
#   O servidor nunca fala com o GitHub. Quem publica e este workflow, que se
#   conecta nele e manda os arquivos por rsync. Trocar de repositorio e
#   invisivel para o servidor.
#
#   Este arquivo tambem cria as pastas de destino antes de enviar, entao nem
#   isso precisa ser feito na mao la dentro.
#
# O QUE MUDOU EM RELACAO AO WORKFLOW ANTIGO
#
#   1. A SENHA DE ROOT E O IP estavam escritos aqui dentro, em texto claro,
#      no repositorio e em todo o historico do Git. Quem tinha o repositorio
#      tinha o servidor - e com o servidor, todas as mensagens. Agora nada
#      disso mora no arquivo.
#
#   2. O deploy so enviava dist/ e public/. As funcoes de backend
#      (netlify/functions) NUNCA subiam: ficavam paradas na versao do ultimo
#      envio manual. Era por isso que a notificacao de mensagem nova mostrava
#      o texto cifrado cru - a correcao existia no codigo, mas a funcao antiga
#      continuava rodando no servidor. Agora sobem junto.
#
#   3. No fim ele confere o build.json publicado. Se a data nao for a de hoje,
#      avisa - em vez de voce achar que publicou.
# -----------------------------------------------------------------------------

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  publicar:
    name: Build e deploy
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # -----------------------------------------------------------------------
      - name: Descobrir como autenticar
        id: modo
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
          SSH_HOST: ${{ secrets.SSH_HOST }}
          VPS_HOST: ${{ secrets.VPS_HOST }}
          SSH_USER: ${{ secrets.SSH_USER }}
          VPS_USER: ${{ secrets.VPS_USER }}
        run: |
          HOST="${SSH_HOST:-$VPS_HOST}"
          USER="${SSH_USER:-$VPS_USER}"

          if [ -z "$HOST" ] || [ -z "$USER" ]; then
            echo "::error::Faltam os segredos de endereco do servidor."
            echo "Cadastre SSH_HOST e SSH_USER (ou VPS_HOST e VPS_USER) em"
            echo "Settings > Secrets and variables > Actions."
            exit 1
          fi

          if [ -n "$SSH_PRIVATE_KEY" ]; then
            echo "modo=chave" >> "$GITHUB_OUTPUT"
            echo "Autenticacao: chave SSH."
          elif [ -n "$VPS_PASSWORD" ]; then
            echo "modo=senha" >> "$GITHUB_OUTPUT"
            echo "Autenticacao: senha. Funciona, mas migre para chave SSH."
          else
            echo "::error::Nenhuma credencial cadastrada."
            echo "Cadastre SSH_PRIVATE_KEY (recomendado) ou VPS_PASSWORD."
            exit 1
          fi

          echo "host=$HOST" >> "$GITHUB_OUTPUT"
          echo "user=$USER" >> "$GITHUB_OUTPUT"

      # -----------------------------------------------------------------------
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Instalar dependencias
        run: npm install --legacy-peer-deps

      - name: Testar a camada de criptografia
        # Nao trava o deploy por enquanto: o projeto tem backlog de lint e
        # tipos herdado. Quando zerar, troque para false e nenhuma regressao
        # entra em producao.
        continue-on-error: true
        run: npx vitest run src/lib/pq

      - name: Build
        env:
          VITE_BUILD_ID: ${{ github.sha }}
        run: npm run build

      - name: Conferir que o build saiu
        run: |
          test -f dist/index.html || { echo "::error::dist/index.html nao existe."; exit 1; }
          echo "build.json gerado:"
          cat dist/build.json || true

      # -----------------------------------------------------------------------
      - name: Preparar acesso ao servidor
        env:
          MODO: ${{ steps.modo.outputs.modo }}
          HOST: ${{ steps.modo.outputs.host }}
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SSH_KNOWN_HOSTS: ${{ secrets.SSH_KNOWN_HOSTS }}
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq rsync openssh-client
          if [ "$MODO" = "senha" ]; then sudo apt-get install -y -qq sshpass; fi

          mkdir -p ~/.ssh
          chmod 700 ~/.ssh

          # known_hosts: usa o segredo se existir. Senao, pergunta ao servidor.
          # O segredo e melhor - fixar a chave do host e o que impede alguem
          # de se passar pelo servidor no meio do caminho.
          if [ -n "$SSH_KNOWN_HOSTS" ]; then
            printf '%s\n' "$SSH_KNOWN_HOSTS" > ~/.ssh/known_hosts
            echo "known_hosts veio do segredo SSH_KNOWN_HOSTS."
          else
            ssh-keyscan -H "$HOST" > ~/.ssh/known_hosts 2>/dev/null
            echo "::warning::SSH_KNOWN_HOSTS nao cadastrado - usando ssh-keyscan."
          fi
          chmod 600 ~/.ssh/known_hosts

          if [ "$MODO" = "chave" ]; then
            printf '%s\n' "$SSH_PRIVATE_KEY" > ~/.ssh/id_deploy
            chmod 600 ~/.ssh/id_deploy
          fi

      # -----------------------------------------------------------------------
      - name: Enviar para o servidor
        env:
          MODO: ${{ steps.modo.outputs.modo }}
          HOST: ${{ steps.modo.outputs.host }}
          USUARIO: ${{ steps.modo.outputs.user }}
          SSHPASS: ${{ secrets.VPS_PASSWORD }}
        run: |
          set -e
          ALVO="$USUARIO@$HOST"

          if [ "$MODO" = "chave" ]; then
            SSH_CMD="ssh -i ~/.ssh/id_deploy -o StrictHostKeyChecking=yes"
            ENVIAR() { rsync -az --no-perms --no-owner --no-group -e "$SSH_CMD" "$@"; }
            EXECUTAR() { $SSH_CMD "$ALVO" "$1"; }
          else
            SSH_CMD="ssh -o StrictHostKeyChecking=yes"
            ENVIAR() { sshpass -e rsync -az --no-perms --no-owner --no-group -e "$SSH_CMD" "$@"; }
            EXECUTAR() { sshpass -e ssh -o StrictHostKeyChecking=yes "$ALVO" "$1"; }
          fi

          # Garante que as pastas de destino existem. Sem isto, o rsync
          # falharia se /opt/undoing/netlify/functions/ ainda nao existisse
          # no servidor - e essa era a unica coisa que exigiria mexer no VPS
          # na mao. Agora o proprio deploy resolve.
          echo "--- preparando as pastas no servidor"
          EXECUTAR "mkdir -p /opt/undoing/dist /opt/undoing/public /opt/undoing/netlify/functions"

          echo "--- site (dist/)"
          ENVIAR --delete dist/ "$ALVO:/opt/undoing/dist/"

          echo "--- arquivos publicos (public/)"
          # sem --delete: o APK e os videos podem ter sido enviados a mao
          ENVIAR public/ "$ALVO:/opt/undoing/public/"

          echo "--- funcoes de backend (netlify/functions/)"
          ENVIAR netlify/functions/ "$ALVO:/opt/undoing/netlify/functions/"

          echo "--- reiniciando o servico"
          EXECUTAR "systemctl restart undoing 2>/dev/null || sudo systemctl restart undoing 2>/dev/null || echo 'nao consegui reiniciar - reinicie na mao'"

      # -----------------------------------------------------------------------
      - name: Conferir que o site subiu a versao NOVA
        run: |
          sleep 8

          STATUS=$(curl -s -o /dev/null -w "%{http_code}" "https://udgservidor.online/" || echo "000")
          echo "HTTP do site: $STATUS"

          PUBLICADO=$(curl -s "https://udgservidor.online/build.json" || echo "")
          echo "build.json no ar: $PUBLICADO"

          HOJE=$(date -u +%Y-%m-%d)
          case "$PUBLICADO" in
            *"$HOJE"*)
              echo "OK - o servidor esta servindo o build de hoje." ;;
            *)
              echo "::warning::build.json nao tem a data de hoje ($HOJE)."
              echo "O rsync pode nao ter chegado em /opt/undoing/dist/."
              echo "Confira no servidor: ls -la /opt/undoing/dist/build.json" ;;
          esac

          [ "$STATUS" = "200" ] || echo "::warning::O site respondeu $STATUS."
