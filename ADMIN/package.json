{
  "name": "undoing-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Painel de administracao, moderacao e conformidade do UndoinG. Roda local, sem dependencias externas.",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node20-win-x64 --output UndoinG-Admin.exe"
  },
  "pkg": {
    "assets": ["ui/**/*"],
    "targets": ["node20-win-x64"],
    "outputPath": "."
  },
  "engines": { "node": ">=20" }
}
